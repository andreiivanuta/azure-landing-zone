<mxfile host="app.diagrams.net" type="device">
  <diagram name="Trust and components" id="alz-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Boundaries -->
        <mxCell id="plat" value="Platform boundary — azure-landing-zone (created by the Bicep trust anchor)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;fontStyle=1;strokeColor=#6c8ebf;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="760" height="320" as="geometry" />
