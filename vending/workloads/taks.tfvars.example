# Per-workload intake — ONE file per workload (the committed registry).
# The pipeline applies this file with its own state key:
#   terraform apply -var="workload_name=<name>" -var-file="workloads/<name>.tfvars"
#
# MINIMAL FORM — only the two facts the platform can't know for you are required.
# Region defaults to the platform region, and identities default to the standard
# plan/deploy/cleanup archetype (see the overrides below).

workload = {
  subject_prefix      = "repo:OWNER@OWNER_ID/terraform-aks-sandbox@REPO_ID"
  resource_group_name = "rg-taks-sandbox-swc"
}

# --- Optional overrides (delete if you just want the defaults) -----------------
#
# Region — defaults to the platform region from config/project.json:
#   location      = "swedencentral"
#   location_code = "swc"
#
# Deletion protection (default ON). A protected workload cannot be offboarded by just
# deleting this file — the destroy workflow refuses until this is set to false in a PR
# (or a maintainer re-runs vending-destroy manually with force = true). Set to false
# only for throwaway/sandbox workloads you are comfortable tearing down freely:
#   deletion_protection = false
#
# Owner (optional) — surfaced on the resource group tag and in destroy previews, so a
# reviewer knows who to contact before offboarding:
#   owner = "team-or-user@example.com"
#
# Identities — default archetype (override only if you need something different):
#   plan    -> Reader      + Storage Blob Data Reader      , environments ["plan"]
#   deploy  -> Contributor + Storage Blob Data Contributor , environments ["apply","destroy"]
#   cleanup -> Contributor + Storage Blob Data Contributor , environments ["cleanup"]
#
# The module's guardrails reject anything outside policy: control-plane role must be
# Reader/Contributor, state role must be a Storage Blob Data Reader/Contributor, no
# wildcards in the subject, and every identity needs at least one environment.
#
#   identities = {
#     plan    = { resource_group_role = "Reader",      state_role = "Storage Blob Data Reader",      environments = ["plan"] }
#     deploy  = { resource_group_role = "Contributor", state_role = "Storage Blob Data Contributor", environments = ["apply", "destroy"] }
#     cleanup = { resource_group_role = "Contributor", state_role = "Storage Blob Data Contributor", environments = ["cleanup"] }
#   }
